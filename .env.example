# ============================================================================
# DQ Command Center - Environment Configuration Template
# ============================================================================
#
# IMPORTANT: This file shows ALL required environment variables.
# Copy this to .env and fill in YOUR OWN secure values.
# NEVER commit real secrets to version control.
#
# For production: Use a secrets management system (AWS Secrets Manager,
# HashiCorp Vault, etc.) instead of environment files.
#

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# There are no code defaults for database credentials or JWT secrets: the
# backend refuses to start if they are missing, empty or left as the
# placeholder values below. Use your own random values, even locally, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD must match the password inside both DATABASE_URL values.
# Production additionally refuses short (<16 chars) or dev/example-looking
# database passwords.

POSTGRES_USER=dqadmin
POSTGRES_PASSWORD=ChangeMe_Database_Password_Min_12_Chars
POSTGRES_DB=dq_command_center
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://dqadmin:ChangeMe_Database_Password_Min_12_Chars@postgres:5432/dq_command_center
DATABASE_URL_SYNC=postgresql://dqadmin:ChangeMe_Database_Password_Min_12_Chars@postgres:5432/dq_command_center

# ============================================================================
# JWT & AUTHENTICATION CONFIGURATION
# ============================================================================

# Required in every environment, at least 32 random characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The placeholder below is refused at startup on purpose.
JWT_# Required in production (at least 32 random characters); not used otherwise.
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# ADMIN INITIALIZATION (First-Time Setup Only)
# ============================================================================
# Leave empty to require registration as first user
# Only set these to auto-create admin during initialization

INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=
INIT_ADMIN_NAME=

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
RATE_LIMIT_PER_MINUTE=20
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# ============================================================================
# EMAIL CONFIGURATION (SMTP - optional, uses mock in dev)
# ============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@dqcommandcenter.com
SMTP_USE_TLS=true
# Leave SMTP_HOST/SMTP_USER empty to run in mock mode: emails are logged
# (without secrets) instead of sent, and dev-only endpoints echo tokens
# in the API response (see SECURITY.md).

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

APP_NAME=DQ Command Center
ENVIRONMENT=development
# Local-only escape hatch for running without SMTP: when true AND
# ENVIRONMENT=development, verification/password-reset tokens are returned in
# API responses. That lets ANY caller reset ANY account (including admins), so
# never set this on a machine other people can reach (e.g. a private beta).
DEV_EXPOSE_AUTH_TOKENS=false
# Development only: log every SQL statement WITH its bound parameters
# (password hashes, token hashes, cell values). Leave off unless debugging.
SQL_ECHO=false
LOG_LEVEL=DEBUG
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Relative, so it works through nginx (http://localhost) and the Vite dev
# server (http://localhost:5173, which proxies /api to the backend).
VITE_API_BASE_URL=/api
VITE_ENV=development
